{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{
					"slug": "blue",
					"name": "Blue (buttons, links, icons)",
					"color": "#1F5CA8"
				},
				{
					"slug": "blue-dark",
					"name": "Blue dark (hover, footer)",
					"color": "#163F78"
				},
				{
					"slug": "navy",
					"name": "Navy (headings & text)",
					"color": "#14213D"
				},
				{
					"slug": "red",
					"name": "Red (logo & small accents only)",
					"color": "#D2232A"
				},
				{
					"slug": "white",
					"name": "White (background)",
					"color": "#FFFFFF"
				},
				{
					"slug": "sky",
					"name": "Sky (soft sections, cards)",
					"color": "#EEF4FB"
				},
				{
					"slug": "line",
					"name": "Line (borders)",
					"color": "#D6E2F0"
				},
				{
					"slug": "muted",
					"name": "Muted text",
					"color": "#5B6B82"
				}
			],
			"gradients": [
				{
					"slug": "hero-scrim",
					"name": "Hero scrim (navy)",
					"gradient": "linear-gradient(180deg, rgba(20,33,61,0.72) 0%, rgba(20,33,61,0.40) 45%, rgba(20,33,61,0.85) 100%)"
				},
				{
					"slug": "card-scrim",
					"name": "Card scrim (text over image)",
					"gradient": "linear-gradient(180deg, rgba(20,33,61,0) 25%, rgba(20,33,61,0.88) 100%)"
				}
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vh",
				"vw",
				"svh"
			],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "2XS",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "XS",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "clamp(1.25rem, 2.5vw, 1.75rem)"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(1.75rem, 4vw, 2.75rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(2.5rem, 6vw, 4.5rem)"
				},
				{
					"slug": "70",
					"name": "2XL",
					"size": "clamp(3.5rem, 9vw, 7rem)"
				},
				{
					"slug": "80",
					"name": "3XL",
					"size": "clamp(4.5rem, 12vw, 9.5rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "XS (labels)",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Heading S",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Heading M",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "huge",
					"name": "Heading L",
					"size": "4.5rem",
					"fluid": {
						"min": "2.875rem",
						"max": "5.5rem"
					}
				},
				{
					"slug": "colossal",
					"name": "Display",
					"size": "6.5rem",
					"fluid": {
						"min": "3.25rem",
						"max": "7.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Instrument Serif (headings)",
					"fontFamily": "\"Instrument Serif\", \"Times New Roman\", Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-400-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "sans",
					"name": "Inter (body & UI)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"border": {
			"radius": true,
			"color": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 18px 40px -18px rgba(20,33,61,0.25)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 24px 60px -24px rgba(20,33,61,0.35)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "12px",
				"md": "16px",
				"lg": "24px",
				"pill": "999px"
			},
			"header-height": "76px",
			"transition": "cubic-bezier(.2,.7,.2,1)"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--navy)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2.5rem)",
				"right": "clamp(1rem, 4vw, 2.5rem)",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400",
					"lineHeight": "1.02",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--navy)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--colossal)",
					"lineHeight": "0.95",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.3"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--blue)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				"border": {
					"radius": "999px",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.4rem",
						"right": "1.4rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--blue-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				}
			},
			"core/cover": {
				"border": {
					"radius": "var(--wp--custom--radius--lg)"
				}
			},
			"core/quote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "800",
					"fontSize": "1.625rem",
					"letterSpacing": "-0.05em"
				},
				"color": {
					"text": "var(--wp--preset--color--red)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/details": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--line)",
						"width": "1px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"top": "1.1rem",
						"bottom": "1.1rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page — full width (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
